  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine.Scripting.Orchestration\Engine.Scripting.Orchestration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

</Project>
