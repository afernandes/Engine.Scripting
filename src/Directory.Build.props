<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="NuGet packaging">
    <VersionPrefix>0.1.1</VersionPrefix>
    <Authors>Anderson Fernandes do Nascimento</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/afernandes/Engine.Scripting</PackageProjectUrl>
    <RepositoryUrl>https://github.com/afernandes/Engine.Scripting.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>hot-reload;scripting;roslyn;csharp;assemblyloadcontext;collectible;plugins;hot-swap</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Symbols embedded in the DLL (with sources): consumers debug the package with zero
         symbol-server/SourceLink setup — the same embed strategy the library applies to scripts. -->
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
